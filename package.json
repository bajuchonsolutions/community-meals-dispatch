{
  "name": "community-meals-dispatch",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute community-meals-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute community-meals-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute community-meals-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
