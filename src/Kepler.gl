import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:geolocator/geolocator.dart';
import React, { useEffect } from 'react';
import { createStore, combineReducers, applyMiddleware } from 'redux';
import { Provider, useDispatch } from 'react-redux';
import keplerGlReducer from 'kepler.gl/reducers';
import { addDataToKeplerGl } from 'kepler.gl/actions';
import KeplerGl from 'kepler.gl';
import { taskMiddleware } from 'react-palm/tasks';

class ProximityScannerButton extends StatefulWidget {
  final double targetLat;
  final double targetLng;
  final VoidCallback onUnlockScan;

  const ProximityScannerButton({
    Key? key,
    required this.targetLat,
    required this.targetLng,
    required this.onUnlockScan,
  }) : super(key: key);

  @override
  _ProximityScannerButtonState createState() => _ProximityScannerButtonState();
}

class _ProximityScannerButtonState extends State<ProximityScannerButton> with SingleTickerProviderStateMixin {
  bool isUnlocked = false;
  double currentDistance = double.infinity;
  late AnimationController _pulseController;

  @override
  void initState() {
    super.initState();
    _pulseController = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 1),
    )..repeat(reverse: true);
    _checkGeofence();
  }

  Future<void> _checkGeofence() async {
    // Listen to real-time location stream
    Geolocator.getPositionStream(
      locationSettings: const LocationSettings(accuracy: LocationAccuracy.high, distanceFilter: 5)
    ).listen((Position position) {
      double distanceInMeters = Geolocator.distanceBetween(
        position.latitude, position.longitude, 
        widget.targetLat, widget.targetLng
      );
      
      setState(() {
        currentDistance = distanceInMeters;
        // 50-meter Proximity Lock logic
        if (distanceInMeters <= 50.0 && !isUnlocked) {
          isUnlocked = true;
          HapticFeedback.heavyImpact(); // Haptic confirmation for single-handed UX
        } else if (distanceInMeters > 50.0) {
          isUnlocked = false;
        }
      });
    });
  }

  @override
  void dispose() {
    _pulseController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _pulseController,
      builder: (context, child) {
        return ElevatedButton(
          style: ElevatedButton.styleFrom(
            backgroundColor: isUnlocked 
                ? Color.lerp(const Color(0xFFFF9900), const Color(0xFFE68A00), _pulseController.value) // Logistics Orange Pulse
                : const Color(0xFF1E1E1E), // Disabled Surface Grey
            minimumSize: const Size(double.infinity, 80), // Large tap target
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
          ),
          onPressed: isUnlocked ? widget.onUnlockScan : null,
          child: Text(
            isUnlocked ? "UNLOCK: SCAN MEAL QR" : "DRIVE TO DESTINATION (${currentDistance.toStringAsFixed(0)}m)",
            style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: Colors.white),
          ),
        );
      }
    );
  }
}
// 1. Initialize Redux store for Kepler.gl state management
const reducers = combineReducers({
  keplerGl: keplerGlReducer
});
const store = createStore(reducers, {}, applyMiddleware(taskMiddleware));

const MapDashboard = () => {
  const dispatch = useDispatch();

  useEffect(() => {
    // 2. Fetch the GeoJSON payload from the Analytics Backend
    const fetchPulseData = async () => {
      const response = await fetch('/v1/analytics/spatial/delivery-pulse');
      const geojsonData = await response.json();

      // 3. Inject data into Kepler.gl instance
      dispatch(
        addDataToKeplerGl({
          datasets: {
            info: { label: 'Daily Delivery Flux', id: 'delivery_pulse' },
            data: geojsonData
          },
          config: {
            visState: {
              layers: [{
                type: 'point',
                config: {
                  color: [255, 153, 0], // CommuniMeal Orange
                  visConfig: { radius: 10, opacity: 0.8 }
                }
              }]
            }
          }
        })
      );
    };
    
    fetchPulseData();
  }, [dispatch]);

  return (
    <div style={{ width: '100vw', height: '100vh', display: 'flex' }}>
      {/* Map Container occupying 80% */}
      <div style={{ flex: '0 0 80%' }}>
        <KeplerGl
          id="admin_map"
          width={window.innerWidth * 0.8}
          height={window.innerHeight}
          mapboxApiAccessToken={process.env.REACT_APP_MAPBOX_TOKEN}
          theme="dark"
        />
      </div>
      
      {/* Operations Sidebar */}
      <div style={{ flex: '0 0 20%', backgroundColor: '#121212', color: '#FFF', padding: '16px' }}>
        <h2 style={{ color: '#03DAC6' }}>CommuniMeal Ops</h2>
        <p>Live exception feed and AI Dispatcher will mount here.</p>
      </div>
    </div>
  );
};

export default function AdminApp() {
  return (
    <Provider store={store}>
      <MapDashboard />
    </Provider>
  );
}
